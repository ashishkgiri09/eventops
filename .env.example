# EVENTOPS Frontend Configuration
# Tagline: Run the event, not the paperwork.

# FastAPI Backend Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# API Mock Mode Switch
# Set to 'true' to run fully standalone with realistic mock data (default)
# Set to 'false' to connect to live FastAPI backend endpoints
NEXT_PUBLIC_USE_MOCK_API=true
